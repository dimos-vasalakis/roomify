# LLM (agent brain, room analysis, render check, oumi judge backend)
GEMINI_API_KEY=
# fal: render, swap, walk-in video
FAL_KEY=
# treg: one token for search, page scraping and maps APIs
TREG_TOKEN=
# Optional: SERPER_API_KEY adds web search when shop catalogues find too little
SERPER_API_KEY=
# Not used yet: page reading for shops that block plain requests
FIRECRAWL_API_KEY=
# 1 = serve every external call from the cache in demo/ (no network). Empty = 0
REPLAY=
# Shops the agent may buy from, comma-separated domains (see app/tools/shops.py). Empty = all
RETAILERS=
DEFAULT_CITY=
# Supabase: database and auth. Secret key is server-only, never send it to the front end
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for older projects that sign logins with a shared secret (Settings > JWT Keys > Legacy JWT secret).
# Newer projects use signing keys and leave this empty.
SUPABASE_JWT_SECRET=
# Comma-separated sites allowed to call the API. Empty = http://localhost:5173. Add the Vercel URL once deployed
FRONTEND_ORIGINS=
# Postgres connection for migrations and the backend: Supabase > Connect > Session pooler (port 5432)
DATABASE_URL=
# Where cached results live (default: demo/cache in the repo, used by REPLAY=1)
CACHE_DIR=
# The server downloads missing or week-old shop catalogues in the background. Empty = 1 (on), 0 = off
REFRESH_CATALOGUES=
