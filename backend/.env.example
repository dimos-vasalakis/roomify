# LLM (agent brain, room analysis, render check, oumi judge backend)
GEMINI_API_KEY=
# fal: render, swap, walk-in video
FAL_KEY=
# treg: one token for search, page scraping and maps APIs
TREG_TOKEN=
# Optional direct fallbacks if treg is unavailable
SERPER_API_KEY=
FIRECRAWL_API_KEY=
# 1 = serve every external call from the cache in demo/ (no network)
REPLAY=0
# Comma-separated retailer domains the agent may shop from
RETAILERS=ikea.gr,jysk.gr,leroymerlin.gr
DEFAULT_CITY=Athens
# Supabase: database and auth. Secret key is server-only, never send it to the front end
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Comma-separated origins allowed to call the API (add the Vercel URL once deployed)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Postgres connection for migrations and the backend: Supabase > Connect > Session pooler (port 5432)
DATABASE_URL=
