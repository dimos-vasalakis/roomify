# LLM (agent brain, room analysis, render check, oumi judge backend)
GEMINI_API_KEY=
# Optional model overrides. Planning uses fal when available, otherwise direct Gemini.
GEMINI_MODEL=
FAL_LLM_MODEL=
FAL_RENDER_MODEL=
# Placement, render check and basket fit. Empty = google/gemini-3-flash-preview
VISION_MODEL=
# nano-banana-2 render quality. Empty = 2K and high
FAL_RENDER_RESOLUTION=
FAL_RENDER_THINKING=
# Reading a room for a story (who it's for; the agent decides). Empty = google/gemini-3.1-pro-preview
DEEP_MODEL=
# Oumi hosted inference for the story judge. Both needed; the model is the deployment path
# projects/{project_id}/deployments/{deployment_id}. Empty = the judge runs through the LLM. Server-only.
OUMI_API_KEY=
OUMI_JUDGE_MODEL=
# fal: render, swap, walk-in video
FAL_KEY=
# treg: one token for search, page scraping and maps APIs
TREG_TOKEN=
# Optional: SERPER_API_KEY adds Google Shopping leads beyond the shop catalogues (and web search)
SERPER_API_KEY=
# Optional: reads pages of shops that refuse this server (IKEA from Render) and bot-check pages
FIRECRAWL_API_KEY=
# 1 = serve every external call from the cache in demo/ (no network). Empty = 0
REPLAY=
# Shops the agent may buy from, comma-separated domains (see app/tools/shops.py). Empty = all
RETAILERS=
DEFAULT_CITY=
# Supabase: database and auth. Secret key is server-only, never send it to the front end
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for older projects that sign logins with a shared secret (Settings > JWT Keys > Legacy JWT secret).
# Newer projects use signing keys and leave this empty.
SUPABASE_JWT_SECRET=
# Extra sites allowed to call the API. The production Roomify Vercel URL is always allowed.
# Empty adds http://localhost:5173 for local development.
FRONTEND_ORIGINS=
# Postgres connection for migrations and the backend: Supabase > Connect > Session pooler (port 5432)
DATABASE_URL=
# Where cached results live. Empty = backend/.cache (gitignored); with REPLAY=1, demo/cache.
# To record the demo run, set ../demo/cache
CACHE_DIR=
# The server downloads missing or week-old shop catalogues in the background. Empty = 1 (on), 0 = off
REFRESH_CATALOGUES=
