# Back end base URL, for example http://localhost:8000. Leave empty to run on local sample rooms.
VITE_API_URL=
# Supabase project URL and publishable (anon) key, for login. Never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: the address a phone uses to open this app (the QR code), when this page runs on localhost.
# For example http://192.168.1.20:5173. Empty uses the page's own address.
VITE_PUBLIC_URL=
